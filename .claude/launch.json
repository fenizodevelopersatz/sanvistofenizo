{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "react-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "react-app", "run", "dev"],
      "port": 5175,
      "autoPort": true
    },
    {
      "name": "original-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8899"],
      "port": 8899
    },
    {
      "name": "react-app-v2",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "react-app-v2", "run", "dev"],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "mail-server",
      "runtimeExecutable": "php",
      "runtimeArgs": ["-S", "localhost:8800", "-t", "MAIL"],
